FETCHCONTENT_DECLARE(
    ImNodeFlow
    GIT_REPOSITORY https://github.com/R3sid3ntD1023/ImNodeFlow.git
    GIT_TAG master
)

find_package(imgui CONFIG REQUIRED)
FETCHCONTENT_MAKEAVAILABLE(ImNodeFlow)

get_target_property(IMNODEFLOW_LINK_LIBRARIES ImNodeFlow LINK_LIBRARIES)
if(IMNODEFLOW_LINK_LIBRARIES)
    list(REMOVE_ITEM IMNODEFLOW_LINK_LIBRARIES imgui)
    set_property(TARGET ImNodeFlow PROPERTY LINK_LIBRARIES "${IMNODEFLOW_LINK_LIBRARIES}")
endif()

get_target_property(IMNODEFLOW_INTERFACE_LINK_LIBRARIES ImNodeFlow INTERFACE_LINK_LIBRARIES)
if(IMNODEFLOW_INTERFACE_LINK_LIBRARIES)
    list(REMOVE_ITEM IMNODEFLOW_INTERFACE_LINK_LIBRARIES imgui)
    set_property(TARGET ImNodeFlow PROPERTY INTERFACE_LINK_LIBRARIES "${IMNODEFLOW_INTERFACE_LINK_LIBRARIES}")
endif()

target_link_libraries(ImNodeFlow PUBLIC imgui::imgui)